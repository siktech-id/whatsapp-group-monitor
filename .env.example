# Directory for auth state and database (default: ./data)
DATA_DIR=./data

# Web server port (default: 3000)
PORT=3000

# Log level: debug, info, warn, error (default: info)
LOG_LEVEL=info

# Admin panel credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Days to keep API request logs (default: 30)
API_LOG_RETENTION_DAYS=30

# Proxy hops in front of the app for real client IPs (default: 1 for Railway; 0 = no proxy)
TRUST_PROXY_HOPS=1
